<UserControl x:Class="BgB_TeachingAssistant.Views.StudentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BgB_TeachingAssistant.Views"
             xmlns:converters="clr-namespace:BgB_TeachingAssistant.Helpers.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Background="#18191a">

    <UserControl.Resources>
        <ResourceDictionary>
            <converters:ColumnWidthConverter x:Key="ColumnWidthConverter" />

            <!-- Merge External Style Files -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/DataGrid/DataGridStyles.xaml" />
                <ResourceDictionary Source="Resources/Styles/DataGrid/DataGridColumnHeaderStyles.xaml" />
                <ResourceDictionary Source="Resources/Styles/DataGrid/DataGridCellStyles.xaml" />
                <ResourceDictionary Source="Resources/Styles/Buttons/Buttons.xaml" />
            </ResourceDictionary.MergedDictionaries>


        </ResourceDictionary>
               

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.4*"/>
            <!-- First column -->
            <ColumnDefinition Width="4*"/>
            <!-- Second column -->
        </Grid.ColumnDefinitions>

        <!-- Left Column -->
        <Border Background="#353535" Grid.Column="0" Margin="10" CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <!-- Buttons and ComboBox -->
                    <RowDefinition Height="*"/>
                    <!-- DataGrid fills remaining space -->
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="10">
                    <Button Content="Hello Click Me!" 
                            Style="{StaticResource SaveButton}"
                            Command="{Binding DanCukCommand}" 
                            Width="150" 
                            Margin="0,0,0,5"/>
                    <Button Content="Load Students" 
                            Style="{StaticResource SaveButton}"
                            Command="{Binding LoadStudentsCommand}" 
                            Width="150" 
                            Margin="0,0,0,5"/>
                    <ComboBox Name="StudentComboBox" ItemsSource="{Binding StudentNames}" />
                    <TextBox Width="200" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <DataGrid ItemsSource="{Binding FilteredItems}" 
                              Style="{StaticResource DataGridTimeTableStyle}"
                              CellStyle="{Binding CurrentCellStyle}"
                              ColumnHeaderStyle="{StaticResource TimeTableColumnHeaderStyle}"
                              MaxWidth="400"
                              SelectionMode="Single"
                              CanUserResizeRows="False"
                              CanUserResizeColumns="False"
                              CanUserSortColumns="False"
                              CanUserReorderColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              AutoGenerateColumns="False" 
                              HorizontalAlignment="Stretch" 
                              VerticalAlignment="Stretch" 
                              SelectionUnit="FullRow"
                              HorizontalGridLinesBrush="White" 
                              VerticalGridLinesBrush="White"
                              HorizontalScrollBarVisibility="Disabled"
                              HeadersVisibility="Column"
                              Margin="10">
                        <DataGrid.ItemContainerStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridRow">
                                            <Border x:Name="RowBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                <Grid>
                                                    <!-- Row Content -->
                                                    <ContentPresenter />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <!-- Highlighting Behavior -->
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="RowBorder" Property="Background" Value="White" />
                                                    <Setter Property="Foreground" Value="Black" />
                                                </Trigger>
                                                <Trigger Property="Selector.IsSelectionActive" Value="False">
                                                    <Setter TargetName="RowBorder" Property="Background" Value="White" />
                                                    <Setter Property="Foreground" Value="Black" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.ItemContainerStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding StudentNumber}" Width="1*" />
                            <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="2*" />
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="6*" />
                            <DataGridTextColumn Header="ID" Binding="{Binding StudentID}" Width="1.5*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Right Column -->
        <Border Background="#353535" Grid.Column="1" Margin="10" CornerRadius="10">
            <StackPanel Orientation="Vertical">
                <!-- TreeView -->
                <TreeView>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Style.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="LightGreen"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="LightGreen"/>
                            </Style.Resources>
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="LightGreen"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <!-- TreeView items -->
                    <TreeViewItem Header="Root">
                        <TreeViewItem Header="Child 1"/>
                        <TreeViewItem Header="Child 2"/>
                        <TreeViewItem Header="Child 3">
                            <TreeViewItem Header="Grandchild 1"/>
                            <TreeViewItem Header="Grandchild 2"/>
                        </TreeViewItem>
                    </TreeViewItem>
                </TreeView>

                <!-- TextBox -->
                <TextBox Width="200" Height="100" Text="Sample Text" SelectionBrush="LightCoral" SelectionOpacity="0.5"/>

                <!-- ListBox -->
                <ListBox Width="150">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Name="Border" Padding="2" SnapsToDevicePixels="true">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="Yellow"/>
                                                <Setter Property="Foreground" Value="Red"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBoxItem>Item 1</ListBoxItem>
                    <ListBoxItem>Item 2</ListBoxItem>
                    <ListBoxItem>Item 3</ListBoxItem>
                    <ListBoxItem>Item 4</ListBoxItem>
                </ListBox>
            </StackPanel>

        </Border>
    </Grid>
</UserControl>
